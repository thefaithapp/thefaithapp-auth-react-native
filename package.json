{
  "name": "@thefaithapp/auth-react-native",
  "version": "0.1.0",
  "description": "Hosted member authentication and authorized v1 API access for React Native and Expo apps.",
  "license": "MIT",
  "homepage": "https://thefaithapp.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefaithapp/thefaithapp-auth-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/thefaithapp/thefaithapp-auth-react-native/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./app.plugin": "./app.plugin.js"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "test": "vitest run && npm run test:security",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run security:check && npm run clean && npm run build && npm run test",
    "security:prepare": "node scripts/security-check.cjs --prepare-only",
    "security:check": "node scripts/security-check.cjs",
    "test:security": "node --test scripts/security-check.test.cjs"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=57.0.0 <58.0.0",
    "expo": ">=57.0.0 <58.0.0",
    "expo-application": ">=57.0.0 <58.0.0",
    "expo-crypto": ">=57.0.0 <58.0.0",
    "expo-secure-store": ">=57.0.0 <58.0.0",
    "expo-web-browser": ">=57.0.0 <58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.84.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.5",
    "@types/react": "^19.2.17",
    "expo": "^57.0.7",
    "expo-application": "^57.0.2",
    "expo-crypto": "^57.0.1",
    "expo-secure-store": "^57.0.1",
    "expo-web-browser": "^57.0.1",
    "react": "^19.2.0",
    "react-native": "^0.86.0",
    "rimraf": "^6.1.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "thefaithapp",
    "react-native",
    "expo",
    "authentication",
    "oauth",
    "pkce"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
