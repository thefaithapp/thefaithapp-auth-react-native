{
  "expo": {
    "name": "TheFaithApp Auth Example",
    "slug": "thefaithapp-auth-react-native-example",
    "scheme": "exp+thefaithapp-auth-react-native-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thefaithapp.reactauthsample"
    },
    "android": {
      "package": "com.thefaithapp.reactauthsample",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@thefaithapp/auth-react-native",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
